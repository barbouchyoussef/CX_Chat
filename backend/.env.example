# ─────────────────────────────────────────────────────────────────────────────
# EY CX Assessment Hub — backend environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cx_assessment
APP_NAME=CX Assessment API
APP_ENV=development

# ── LLM providers ────────────────────────────────────────────────────────────
# The assessment/report/chat features need at least one working chat provider.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optional chat provider (Kimi / Moonshot), used first for chat when set.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Gemini failover for report synthesis + image captioning (comma-separated keys allowed).
GEMINI_API_KEYS=
GEMINI_TEXT_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-flash-latest
GEMINI_VLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-lite-latest

# OpenRouter VLM failover (desk-research image captioning).
OPENROUTER_API_KEY=
OPENROUTER_VLM_MODEL=

# ── Web search + scraping ────────────────────────────────────────────────────
LANGSEARCH_API_KEY=
LANGSEARCH_BASE_URL=https://api.langsearch.com/v1
# Apify token for the social-listening scrapers (reviews, Facebook, etc.).
APIFY_API_TOKEN=
# Bright Data token for Facebook page/comment scraping (page scraping is skipped when unset).
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_FB_POSTS_DATASET_ID=gd_lkaxegm826bjpoo9m5
BRIGHTDATA_FB_COMMENTS_DATASET_ID=gd_lkay758p1eanlolqw8

# ── Desk Research & RAG ──────────────────────────────────────────────────────
# EasyOCR languages for scanned PDFs. Arabic-family only combines with English.
DESK_OCR_LANGS=ar,en
# Embeddings backend for the chatbots: "local" (multilingual-e5-small) or "none" (lexical).
RAG_EMBED_BACKEND=local
RAG_EMBED_MODEL=intfloat/multilingual-e5-small
# Minimum cosine similarity to keep a semantic hit (0 = keep top-k regardless).
RAG_MIN_SCORE=0.0

# ── Metabase dashboards (optional) ───────────────────────────────────────────
METABASE_SITE_URL=
METABASE_EMBED_SECRET=
METABASE_DASHBOARD_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Where the "book a consultation" form sends notifications (optional).
CONSULTATION_RECEIVER_EMAIL=
